# Student Ops Desk - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: OpenAI-compatible base URL for Gemini
# Use: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Required: Model configuration for smart routing
# Simple requests (Flash-Lite): https://ai.google.dev/gemini-api/docs/models#gemini-3.5-flash-lite
GEMINI_SIMPLE_MODEL=gemini-3.5-flash-lite
# Complex requests (full Flash): gemini-3.6-flash
GEMINI_COMPLEX_MODEL=gemini-3.6-flash

# Optional: Tracing export key (for observability)
TRACING_KEY=your_tracing_key_here

# Optional: Chainlit configuration
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Optional: Log level
LOG_LEVEL=INFO